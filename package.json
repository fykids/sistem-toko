{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "db:migrate:remote": "npx wrangler d1 execute DB --remote --file=database/d1/0001_create_api_sessions.sql --config wrangler.toml",
        "db:seed:master:remote": "npx wrangler d1 execute sistem_showroom_db --remote --file=database/seed_master.sql --config wrangler.toml",
        "deploy:pages": "npm run build && node scripts/deploy-pages.js",
        "deploy:worker": "npx wrangler deploy --config wrangler.toml",
        "dev:worker": "npx wrangler dev --config wrangler.toml",
        "test:worker": "node --test tests/worker-api.test.js",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@hotwired/turbo": "^8.0.23",
        "bcryptjs": "^3.0.3",
        "hono": "^4.13.18",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0"
    }
}
